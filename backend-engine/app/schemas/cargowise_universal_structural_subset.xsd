<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.cargowise.com/Schemas/Universal/2011/11"
           xmlns="http://www.cargowise.com/Schemas/Universal/2011/11"
           elementFormDefault="qualified">

  <xs:element name="UniversalInterchange">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Header">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="SenderID" type="xs:string" />
              <xs:element name="RecipientID" type="xs:string" />
              <xs:element name="CorrelationID" type="xs:string" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Body">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="UniversalShipment">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Shipment">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="DataContext">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="DataTargetCollection">
                                  <xs:complexType>
                                    <xs:sequence>
                                      <xs:element maxOccurs="unbounded" name="DataTarget">
                                        <xs:complexType>
                                          <xs:sequence>
                                            <xs:element name="Type" type="xs:string" />
                                            <xs:element name="Key" type="xs:string" />
                                          </xs:sequence>
                                        </xs:complexType>
                                      </xs:element>
                                    </xs:sequence>
                                  </xs:complexType>
                                </xs:element>
                                <xs:element name="Company">
                                  <xs:complexType>
                                    <xs:sequence>
                                      <xs:element name="Code" type="xs:string" />
                                    </xs:sequence>
                                  </xs:complexType>
                                </xs:element>
                                <xs:element name="EnterpriseID" type="xs:string" />
                                <xs:element name="ServerID" type="xs:string" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="PortOfOrigin">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="Code" type="xs:string" />
                                <xs:element name="Name" type="xs:string" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="PortOfDestination">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="Code" type="xs:string" />
                                <xs:element name="Name" type="xs:string" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element minOccurs="0" name="OrganizationAddressCollection">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element maxOccurs="unbounded" name="OrganizationAddress">
                                  <xs:complexType>
                                    <xs:sequence>
                                      <xs:element name="AddressType" type="xs:string" />
                                      <xs:element name="OrganizationCode" type="xs:string" />
                                    </xs:sequence>
                                  </xs:complexType>
                                </xs:element>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element minOccurs="0" name="CommercialInvoiceCollection">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element maxOccurs="unbounded" name="CommercialInvoice">
                                  <xs:complexType>
                                    <xs:sequence>
                                      <xs:element name="InvoiceNumber" type="xs:string" />
                                      <xs:element name="Incoterm">
                                        <xs:complexType>
                                          <xs:sequence>
                                            <xs:element name="Code" type="xs:string" />
                                          </xs:sequence>
                                        </xs:complexType>
                                      </xs:element>
                                      <xs:element name="InvoiceAmount">
                                        <xs:complexType>
                                          <xs:simpleContent>
                                            <xs:extension base="xs:decimal">
                                              <xs:attribute name="Currency" type="xs:string" use="optional" />
                                            </xs:extension>
                                          </xs:simpleContent>
                                        </xs:complexType>
                                      </xs:element>
                                      <xs:element name="InsuranceAmount">
                                        <xs:complexType>
                                          <xs:simpleContent>
                                            <xs:extension base="xs:decimal">
                                              <xs:attribute name="Currency" type="xs:string" use="optional" />
                                            </xs:extension>
                                          </xs:simpleContent>
                                        </xs:complexType>
                                      </xs:element>
                                      <xs:element minOccurs="0" name="CommercialInvoiceLineCollection">
                                        <xs:complexType>
                                          <xs:sequence>
                                            <xs:element maxOccurs="unbounded" name="CommercialInvoiceLine">
                                              <xs:complexType>
                                                <xs:sequence>
                                                  <xs:element name="LineNumber" type="xs:integer" />
                                                  <xs:element name="Description" type="xs:string" />
                                                  <xs:element name="HarmonizedCode" type="xs:string" />
                                                  <xs:element name="CustomsValue">
                                                    <xs:complexType>
                                                      <xs:simpleContent>
                                                        <xs:extension base="xs:decimal">
                                                          <xs:attribute name="Currency" type="xs:string" use="optional" />
                                                        </xs:extension>
                                                      </xs:simpleContent>
                                                    </xs:complexType>
                                                  </xs:element>
                                                </xs:sequence>
                                              </xs:complexType>
                                            </xs:element>
                                          </xs:sequence>
                                        </xs:complexType>
                                      </xs:element>
                                    </xs:sequence>
                                  </xs:complexType>
                                </xs:element>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element minOccurs="0" name="CustomizedFieldCollection">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element maxOccurs="unbounded" name="CustomizedField">
                                  <xs:complexType>
                                    <xs:sequence>
                                      <xs:element name="Key" type="xs:string" />
                                      <xs:element name="DataType" type="xs:string" />
                                      <xs:element name="Value" type="xs:string" />
                                    </xs:sequence>
                                  </xs:complexType>
                                </xs:element>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="version" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required" />
    </xs:complexType>
  </xs:element>

</xs:schema>
