# TradeTech Systems Studio - Environment Configuration
# API Keys & Cloud Services
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Reverse proxies whose X-Forwarded-For is trusted for rate limiting (comma-separated IPs).
# Leave empty when the app is reached directly.
TRUSTED_PROXY_IPS=

# Hash-chained resolutions ledger (SQLite). Use a persistent volume in production.
LEDGER_DB_PATH=

# CargoWise identifiers written into generated XML (no transmission is performed)
CARGOWISE_COMPANY_CODE=CPH
CARGOWISE_ENTERPRISE_ID=TRN
CARGOWISE_SERVER_ID=A04
CARGOWISE_SENDER_ID=TRADESYSTEMS_PREAUDIT
CARGOWISE_RECIPIENT_ID=CW1_EADAPTOR_SANDBOX
